# Prediction Lab does not require any API key to run.
# LLM providers are optional and only used for hypothesis generation / criticism (post-Milestone 1).
# Never commit a filled-in .env.

# PREDLAB_LLM_PROVIDER=
# PREDLAB_LLM_API_KEY=

# Raw confidential data must never be forwarded to an external LLM API.
# See docs/ARCHITECTURE.md, section "Security boundaries".
