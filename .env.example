# Prediction Lab runs with no credentials at all for the Loto work.
# These are needed only for the live France Travail collector.
#
# Copy this file to .env and fill it in. .env is git-ignored and must stay that way.
# If a value ever reaches a commit, a screenshot or a chat: revoke it, do not edit it out.

# francetravail.io -> your application -> identifiant client / clé secrète
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=

# OAuth scope for the Offres d'emploi v2 API. Confirmed against the official
# documentation before first use; override here if France Travail changes it.
FRANCETRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# Optional LLM provider, for hypothesis generation and criticism only (post-Milestone 1).
# Never used for numerical work, and raw data is never forwarded to it.
# PREDLAB_LLM_PROVIDER=
# PREDLAB_LLM_API_KEY=
